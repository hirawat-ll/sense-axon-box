function object1Min() = [-52.949, -40.900, -17.605];
function object1Max() = [53.759, 41.862, 11.469];
// =====================================================================
//  VENT SECTION -- Axon 0.3/0.2 case bottom -- ventilation ring
//  Added on top of the imported STEP/STL mesh (object1, unchanged).
//
//  Why: the tray only breathes through the two END walls (the two slat
//  grilles already in the mesh, z = -14.5 ... -7.5).  The two long walls
//  are solid, so with an active cooler (fan + heatsink) in the bottom bar
//  the air has only one in/out axis and the corners of the tray stay dead.
//  This block cuts a matching slot grille into BOTH long walls, in the same
//  z band as the original grilles, so the tray is vented on all four sides
//  (a continuous ring around the cooler bay).
//
//  Cut zones were measured from the mesh so that nothing else is touched:
//    - the inner floor (z = -14.6) and everything above z = -7.6
//    - the end grilles, the rim, the screw bosses and the corner posts
//    - the interior ribs / boss walls that sit against the long walls
//      (-Y wall: x = -29..-17 and x = +31..+40)
//    - the ribs that close the recessed panel of the +Y wall
//      (x = -29..-28 and x = +4..+5)
//
//  --- why the slots look like this (3D printing) --------------------
//   * print as drawn:  floor on the bed.  The slots are then vertical
//     holes in vertical walls, so they need no support and no bridging.
//     Each slot closes with two ~59 deg bevelled ends (vent_corner /
//     vent_bevel) and a 0.8 mm flat cap, i.e. the widest unsupported span
//     is 0.8 mm against a 4 mm bridge allowance.
//   * the profile is a bevelled rectangle, NOT a round-ended capsule: an
//     arc is tangent to the slot's flat sides, and that tangency makes
//     OpenSCAD's exact boolean emit ~1600 hair-thin facets (0.009 mm
//     deep).  The bevelled profile keeps the cut at the mesh's own
//     baseline (146 vs 1736 sliver facets) and saves ~19 % of triangles.
//   * webs between the slots: 4.0 - 2.0 = 2.0 mm wide x 1.8 mm thick
//     -> 4-5 extrusion lines at 0.4 mm nozzle, 3 at 0.6 mm.
//   * the slots stop at z = -7.6, so the rim and the whole upper half of
//     the tray stay as solid as they were.
//   * note: the mesh in this file is wound the way STL/SolidWorks writes
//     it; OpenSCAD exports STL with the opposite winding for polyhedra.
//     Slicers detect and flip that automatically (inside-out volume), but
//     if your slicer complains about normals, that is why.
// =====================================================================

// ---------------------------------------------------------------- mesh
module case_bottom() { object1(1); }

// ------------------------------------------------- grille parameters (mm)
vent_z_top  = -7.6;    // top edge of the new grille band
vent_z_bot  = -14.5;   // bottom edge of the slot band; the inner floor is at
                       // -14.6, so the cut stops 0.1 mm above it (never
                       // intersects the floor slab -> no buried faces)
vent_slot_w = 2.0;     // slot width
vent_pitch  = 4.0;     // slot centre-to-centre pitch (web = pitch - width)
vent_corner = 0.6;     // horizontal bevel at each end of a slot (per side)
vent_bevel  = 1.0;     // its height -> ~59 deg from the build plate, i.e.
                       // steeper than the usual 45 deg support threshold.
                       // keep vent_bevel >= vent_corner; the flat cap left
                       // at the top of the slot is vent_slot_w - 2*vent_corner
//  -> finer grille, closer to the look of the original end grilles:
//     vent_slot_w = 1.0, vent_pitch = 2.5, vent_corner = 0.25
//     (vent_corner must stay below vent_slot_w / 2, or the slot ends in a
//      point and the cap disappears)

// ------------------------------------------------- wall faces to cut through
// (measured from the mesh: -Y wall spans y = -40.9 ... -39.1, ~1.8 mm thick)
negY_out = -42.0;      // -Y long wall: start well outside the outer face
negY_in  = -39.0;      //              0.1 mm past the inner face
// (+Y wall: outer skin y = 38.0 ... 40.9, recessed panel y = 32.5 ... 34.0)
posY_out =  41.5;      // +Y long wall: start well outside the outer face
posY_in  =  31.5;      //              1 mm past the recessed panel

// --------------------------------------- free stretches of the long walls
// [x_from, x_to] of each slot row; keep clear of the ribs listed above.
negY_rows = [[-43.0, -30.0],     // -Y wall, outboard of the cooler bosses
             [-15.0,  29.0]];    // -Y wall, between the cooler bosses
posY_rows = [[-43.0, -30.0],     // +Y wall, outboard of the cooler bosses
             [  7.0,  42.0],     // +Y wall, forward section
             [-27.0,   2.0]];    // +Y wall, through the recessed panel

// ---------------------------------------------------------------- cutters
// vertical slot through a wall whose normal is Y.
// Cross-section: rectangle vent_slot_w x (vent_z_top-vent_z_bot) with the
// four ends bevelled by vent_corner / vent_bevel (steeper than 45 deg), so
// the printed ceiling is a short flat cap (bridge of 0.8 mm) sitting on two
// self-supporting bevels.  All faces planar -> no tangencies, no degenerate
// facets, no support material inside the slot.
module slot_y(y0, y1, xc) {
    hull() {
        // full-width section, inset by the bevel height at both ends
        translate([xc - vent_slot_w / 2, y0, vent_z_bot + vent_bevel])
            cube([vent_slot_w, y1 - y0, vent_z_top - vent_z_bot - 2 * vent_bevel]);
        // full-height section, narrower by the bevel -> bevelled ends
        translate([xc - vent_slot_w / 2 + vent_corner, y0, vent_z_bot])
            cube([vent_slot_w - 2 * vent_corner, y1 - y0, vent_z_top - vent_z_bot]);
    }
}

// evenly spaced row of slots centred in [x_from, x_to]
module slot_row_y(x_from, x_to, y0, y1) {
    n    = floor((x_to - x_from - vent_slot_w) / vent_pitch) + 1;
    span = (n - 1) * vent_pitch + vent_slot_w;
    x0   = x_from + (x_to - x_from - span) / 2 + vent_slot_w / 2;
    for (i = [0 : n - 1]) slot_y(y0, y1, x0 + i * vent_pitch);
}

module long_wall_vents() {
    for (r = negY_rows) slot_row_y(r[0], r[1], negY_out, negY_in);
    for (r = posY_rows) slot_row_y(r[0], r[1], posY_in, posY_out);
}


// =====================================================================
//  FAN SECTION -- 25 x 25 mm fan seat in the tray floor
//
//  The board goes into the tray component-side DOWN, so the RK3588, its
//  heatsink and the fan sit in the layer between the board and the floor.
//  The fan draws air from outside through the seat and blows it up through
//  the heatsink; the hot air leaves through the slot grille in the walls
//  (VENT SECTION below), which sits at exactly this level.
//
//  SCOPE: this is the only change to the case.  The board's screw bosses,
//  the rim, the lid seat, the corner posts and both end grilles are the
//  same geometry as the case that already fits - a material map of the
//  exported part differs from the previous build in nothing outside the
//  fan's 36 x 36 mm footprint.
//
//  The seat is cut, never added.  The floor is only 3.0 mm thick, so a seat
//  raised above the floor would need a union, and the union of a rounded
//  ring with the converted mesh leaves 272 buried duplicate facets in the
//  export.  Cutting keeps the export clean (0 open edges, 0 non-manifold
//  edges) and leaves the heatsink more room:
//
//      fan_lead  0.5 mm  lead-in counterbore at the inner surface
//      guide     2.5 mm  25.7 mm bore through the floor  (fan + 0.35/side)
//      ledge     0.5 mm  22 mm bore -> the fan frame rests on the ledge
//      ------------------------------------------------------------------
//      seat depth 3.0 mm  = the floor's own thickness, nothing protrudes
//
//  fan_seat_raised = true adds the 3.5 mm ring from the earlier revision
//  instead (exactly the 3.5 mm asked for).  That version leaves the fan
//  sitting on the floor, costs 3 mm of heatsink room, and produces the
//  buried duplicate facets noted above.
//
//  Position, measured from Vicharak's own data rather than guessed:
//    * the four M2.5 bosses in the floor sit on a 95.5 x 69.0 mm rectangle
//      centred on the tray (measured from this mesh);
//    * the Axon PCB is 101.50 x 75.00 mm with its M2.5 holes 3.0 mm in
//      from every edge (AXON_3D_file_V0.3.step + the documentation), so the
//      board is centred on the screw rectangle;
//    * in that STEP the RK3588 body is 23.00 x 23.00 x 1.89 mm and its
//      centre sits at (-0.75, -0.50) mm from the PCB's centre, on the
//      board's under-face - the face that points at this floor.
//  Hence fan_center = [-0.75, -0.50]: +x toward the +X end wall (the end
//  with the fine grille), +y toward the +Y long wall (the recessed panel).
//  Checked against the case: in that orientation the 22-pin PCIe/SATA FPC
//  on the board's under-face lines up with the 30 x 11 mm opening in the
//  +Y wall.  If the board goes in the other way round, use [+0.75, +0.50].
// =====================================================================

fan_seat        = true;  // false = the bore and ledge without the lead-in
fan_seat_raised = false; // true  = 3.5 mm ring standing on the floor instead
fan_size      = 25.0;   // fan frame, square
fan_clearance = 0.35;   // printed seat = fan_size + 2*clearance
fan_corner_r  = 3.0;    // inner corner radius (fits a 25 mm fan frame)
fan_hole_d    = 22.0;   // ledge bore; a 25 mm fan has a ~23 mm bore, so the
                        // frame's inner 1.5 mm ring still rests on the ledge
fan_lead      = 0.5;    // lead-in counterbore depth (x/y: +fan_lead each side)
fan_ledge     = 0.5;    // floor material left under the fan frame
fan_center    = [-0.75, -0.50];  // RK3588 centre, measured from the board STEP

// the raised variant only (kept for comparison)
fan_wall      = 1.80;   // ring wall
fan_support_h = 3.5;    // ring height above the floor
fan_taper     = 0.20;   // inner face leans out by this over the ring height
fan_sink      = 0.20;   // how far the ring is sunk into the floor

floor_top_z   = -14.6;  // inner floor surface (measured from the mesh)
floor_bot_z   = -17.6;  // outer floor surface -> floor is 3.0 mm thick

// rounded square, centred on the origin
module rr_square(sz, r) {
    hull() for (ix = [-1, 1], iy = [-1, 1])
        translate([ix * (sz / 2 - r), iy * (sz / 2 - r)]) circle(r = r, $fn = 64);
}

// ---- the seat: cut only, so the boolean stays clean -----------------
module fan_seat_cut() {
    d = fan_size + 2 * fan_clearance;
    translate([fan_center[0], fan_center[1], 0]) {
        if (fan_seat)
            translate([0, 0, floor_top_z - fan_lead])
                linear_extrude(fan_lead + 0.1)
                    rr_square(d + 2 * fan_lead, fan_corner_r + fan_lead);
        translate([0, 0, floor_bot_z + fan_ledge])
            linear_extrude((floor_top_z - floor_bot_z) - fan_ledge + 0.1)
                rr_square(d, fan_corner_r);
        translate([0, 0, floor_bot_z - 1])
            cylinder(d = fan_hole_d, h = fan_ledge + 1, $fn = 128);
    }
}

// ---- the earlier raised ring (optional) -----------------------------
module fan_ring() {
    d = fan_size + 2 * fan_clearance;
    difference() {
        linear_extrude(fan_support_h + fan_sink)
            rr_square(d + 2 * fan_wall, fan_corner_r + fan_wall);
        translate([0, 0, -0.1])
            linear_extrude(fan_support_h + fan_sink + 0.2, scale = (d + 2 * fan_taper) / d)
                rr_square(d, fan_corner_r);
    }
}

module fan_holder() {
    if (fan_seat_raised)
        translate([fan_center[0], fan_center[1], floor_top_z - fan_sink]) fan_ring();
}

// ---------------------------------------------------------------- result
// case_bottom();  alone gives the untouched mesh, for comparison.
difference() {
    union() {
        case_bottom();
        fan_holder();
    }
    long_wall_vents();
    fan_seat_cut();
}

